@model Lab4.Models.Learner
@{ ViewData["Title"] = "Sửa học viên"; }
<h1>Sửa học viên</h1>
<div class="row"><div class="col-lg-7">
<form asp-action="Edit" asp-route-id="@Model.LearnerID" method="post">
    <input type="hidden" asp-for="LearnerID" />
    <partial name="_LearnerForm" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Về danh sách</a>
</form>
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
