@model Lab4.Models.Learner
@{ ViewData["Title"] = "Thêm học viên"; }
<h1>Thêm học viên</h1>
<div class="row"><div class="col-lg-7">
<form asp-action="Create" method="post">
    
    <partial name="_LearnerForm" model="Model" />
    <button type="submit" class="btn btn-primary">Thêm học viên</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Về danh sách</a>
</form>
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
