@model Lab5.Models.Learner
@{ ViewData["Title"] = "Chỉnh sửa sinh viên"; }
<a asp-action="Index" class="back-link">← Danh sách sinh viên</a>
<div class="page-heading"><div><div class="eyebrow">HỒ SƠ SINH VIÊN</div><h1>Chỉnh sửa sinh viên</h1><p>Cập nhật thông tin hồ sơ SV@Model.LearnerId.ToString("D4").</p></div></div>
<section class="panel form-panel"><h2>Thông tin cơ bản</h2><form asp-action="Edit" asp-route-id="@Model.LearnerId" method="post"><input type="hidden" asp-for="LearnerId" /><partial name="_LearnerForm" model="Model" /><div class="form-actions"><button type="submit" class="btn btn-primary">Lưu thay đổi</button><a asp-action="Index" class="btn btn-light">Hủy</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
