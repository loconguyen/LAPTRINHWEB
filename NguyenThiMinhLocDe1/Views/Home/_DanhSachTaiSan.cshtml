@{
    ViewData["Title"] = "Danh sach loc";
    Layout = "~/Views/Shared/NTML_Layout.cshtml";
}

<div class="grid">
    @foreach(var item in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="@Url.Content($"~/images/{item.Anh}")" alt="" /></a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot"><span class="price">@item.NguyenGia tr</span><button class="btn-buy">Chi tiết</button></div>
        </div>
    }

</div>