@model NguyenThiMinhLocDe1.Models.TaiSan
<h2>
    them san pham</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="TenTs" class="form-control"></label>
        <input asp-for="TenTs" class="form-control" />

    </div>
    <div class="form-group">
        <label asp-for="NguyenGia" class="form-control"></label>
        <input asp-for="NguyenGia" class="form-control" />

    </div>
