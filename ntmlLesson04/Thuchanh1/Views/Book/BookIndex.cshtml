@{
    ViewData["Title"] = "BookIndex";
}

<h2>Danh sach cac cuon sach</h2>
<form action="" method="post" class="form-inline" role="form">
    <div class="form-group">
        <select name="AuthorId" class="form-control" asp-items="@ViewBag.authors">
            <option value="">
                Chon tac gia
            </option>
        </select>
        <select name="GenreId" class="form-control" asp-items="@ViewBag.genres">
            Chon the loai sach
        </select>
    </div>
    <button type="submit" class="btn btn-primary">
        tim kiem
    </button>
    <a asp-controller="Book" asp-action="CreateIndex" class="btn btn-danger"> them moi</a>

</form>
<hr />
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tieu de</th>
            <th>tac gia</th>
            <th>the loai</th>
            <th>gia</th>
            <th>Hinh anh</th>
            <th></th>

        </tr>
    </thead>
    <tbody>
        @foreach(var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.AuthorId</td>
                <td>@book.GenreId</td>
                <td>@book.Price</td>
                <td><img src="@book.Image" alt="@book.Title" width="40" /></td>
                <td>
                    <a asp-action="Edit"  class="btn btn-primary tbn-sm">Sua</a>
                    
                </td>
            </tr>
        }
    </tbody>
</table>


