
<div class="grid">
    @foreach(var item in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="@Url.Content($"~/images/{item.Anh}")" alt="" /></a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot"><span class="price">@item.NguyenGia tr</span>
                <a class="btn-buy" asp-controller="Home" asp-action="Sua" asp-route-id="@item.MaTs">Sua</a></div>
        </div>
    }
</div>