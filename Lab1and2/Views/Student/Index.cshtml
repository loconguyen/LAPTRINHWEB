@model IEnumerable<Student>

@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<div class="container-fluid px-4">

    <!-- Page Title -->
    <h1 class="mt-4">Student Management</h1>

   


            <!-- Create Student -->
            <a asp-controller="Student"
               asp-action="Create"
               class="btn btn-primary btn-sm">

                <i class="fas fa-plus me-1"></i>
                Create Student
            </a>

        </div>

        <!-- Card Body -->
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Mã</th>
                            <th>Họ tên</th>
                            <th>Ngày sinh</th>
                            <th>Ngành</th>
                            <th>Giới tính</th>
                            <th>Hệ ĐT</th>
                            <th>Địa chỉ</th>
                            <th>Email</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var s in Model)
                        {
                            string str = "";

                            switch (s.Branch)
                            {
                                case Branch.IT:
                                    str = "CNTT";
                                    break;

                                case Branch.BE:
                                    str = "Kinh tế";
                                    break;

                                case Branch.CE:
                                    str = "Công trình";
                                    break;

                                case Branch.EE:
                                    str = "Điện - Điện tử";
                                    break;
                            }

                            <tr>
                               
                                <td>@s.Id</td>

                               
                                <td>@s.Name</td>

                              
                                <td>
                                    @s.DateOfBirth.ToString("dd/MM/yyyy")
                                </td>

                                
                                <td>@str</td>

                                <td>
                                    @(s.Gender == Gender.Male ? "Nam" : "Nữ")
                                </td>

                              
                                <td>
                                    @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                                </td>

                                <td>@s.Address</td>

                                
                                <td>@s.Email</td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
    
@section Scripts {
    <script>
        var table = document.querySelector("table");

        if (table) {
            table.onclick = function onTableClick() {
                table.style.backgroundColor = "yellow";
            };
        }
    </script>
}
