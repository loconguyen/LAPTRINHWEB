<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý sản phẩm</title>
    <link rel="stylesheet" href="~/css/product.css">
</head>

<body>

    <div class="container">

        <h2>Quản lý sản phẩm</h2>

        <table>
