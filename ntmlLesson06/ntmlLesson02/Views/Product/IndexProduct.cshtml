                    <td>
                        <img src="images/product.jpg" alt="Product 2">
                    </td>
                    <td>
                        <button class="btn-view">View</button>
                    </td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Product 3</td>
                    <td>550,000 đ</td>
                    <td>25-12-2020</td>
                    <td>
                        <img src="images/product.jpg" alt="Product 3">
                    </td>
                    <td>
                        <button class="btn-view">View</button>
                    </td>
                </tr>

                <tr>
                    <td>4</td>
                    <td>Product 4</td>
                    <td>550,000 đ</td>
                    <td>25-12-2020</td>
                    <td>
                        <img src="images/product.jpg" alt="Product 4">
                    </td>
                    <td>
                        <button class="btn-view">View</button>
                    </td>
                </tr>

            </tbody>
        </table>

    </div>

</body>
</html>