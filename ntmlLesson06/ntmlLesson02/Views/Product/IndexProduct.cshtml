                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Created At</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>1</td>
                    <td>Product 1</td>
                    <td>500,000 đ</td>
                    <td>25-12-2020</td>
                    <td>
                        <img src="images/product.jpg" alt="Product 1">
                    </td>
                    <td>
                        <button class="btn-view">View</button>
                    </td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Product 2</td>
                    <td>700,000 đ</td>
