@{
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Layout mới</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>
    <!-- Header của Layout mới -->
    <header class="text-white p-4"
            style="background-color: purple;">
        <h2>ĐÂY LÀ LAYOUT MỚI</h2>
    </header>

    <!-- Thanh điều hướng -->
    <nav class="bg-light p-3">
        <a asp-controller="Home"
           asp-action="Index"
           class="me-3">
            Trang chủ
        </a>

        <a asp-controller="Home"
           asp-action="Privacy">
            Chính sách
        </a>
    </nav>

    <!-- Nội dung từ View -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-center p-3 mt-5"
            style="background-color: #eeeeee;">
        <p>Footer của Layout mới - Lab 07</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
