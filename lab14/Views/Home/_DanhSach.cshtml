
<main class="main">
    <div class="container">

        <!-- Sách mới -->
        <div class="section-head">
            <h3>Nguyen Thi Minh Loc</h3>
            <a href="#">Xem tất cả &rsaquo;</a>
        </div>
        <div class="grid">
            @foreach(var item in Model)
            {
                <div class="book-card">
                    <a href="#"><img src="@Url.Content($"~/images/{item.Anh}")" alt="" /></a>
                    <h2>@item.TenSach</h2>
                    <div class="book-foot"><span class="price">@item.Gia</span><button class="btn-buy">Thêm vào giỏ</button></div>
                </div>
                
            }
           
            
        </div>

      
    </div>
</main>