@model IEnumerable<lab14.Models.TheLoai>
<div class="topbar">
    <div class="container">
        <span>Hotline: <b>1900 6789</b> &nbsp;|&nbsp; Miễn phí vận chuyển đơn từ 300.000đ</span>
        <span>Đăng nhập &nbsp;|&nbsp; Đăng ký</span>
    </div>
</div>
<div class="header-main">
    <div class="container">
        <a href="index.html"><img src="images/logo.png" alt="BookHub" /></a>
        <div class="cart-box">Giỏ hàng: 0 sản phẩm - 0đ</div>
    </div>
</div>
<nav class="navbar">
    <div class="container">
        <ul class="menu">
            <li class="active"><a href="index.html">Nguyen thi minh loc</a></li>
            @foreach(var item in Model)
            {
                <li><a href="@Url.Action("LocSach","Home")" class="loc-sach" data-ma="@item.MaTl">@item.TenTl</a></li>
            }
            
        </ul>
        <form class="search-box">
            <input type="text" placeholder="Tìm sách..." />
            <button type="button">Tìm</button>
        </form>
    </div>
</nav>